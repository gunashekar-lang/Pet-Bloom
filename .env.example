# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit the publishable/anon key.
#
# Supabase Studio → Project Settings → API
#   Project URL          → SUPABASE_URL
#   Publishable key      → SUPABASE_PUBLISHABLE_KEY
#
# The publishable key is safe to ship in a client app: it is protected by the
# RLS policies in supabase/schema.sql,
# not by secrecy. Never use the secret
# (service_role) key here — that one bypasses RLS and would expose every row
# to any user.
#
# Newer projects label this "publishable key" (sb_publishable_...); older ones
# call it the "anon public" key (eyJ...). Both are accepted, and
# SUPABASE_ANON_KEY still works as a fallback.

SUPABASE_URL=https://gsyzqytiitkmtjlcqdst.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_gU5FrehFxdc2X9YH6rGIlw_tR39lEO6
